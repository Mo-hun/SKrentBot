# Discord notification settings.
# Use either DISCORD_WEBHOOK_URL or the bot token/channel pair below.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Discord bot mode.
# DISCORD_BOT_TOKEN=your_bot_token
# DISCORD_CHANNEL_ID=your_channel_id

# Telegram bot mode.
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id

# SK렌터카 API endpoint observed from the car-list page.
SKR_API_URL=https://rent.skdirect.co.kr/skr/common/comm-dotcom-bff/api/v2/proxy/commontunnel

# Copy the exact POST body for your selected schedule from DevTools Network.
# It must be valid JSON on one line. If it is large, use SKR_REQUEST_BODY_FILE instead.
SKR_REQUEST_BODY_JSON={"replace":"with the copied commontunnel request body"}
# SKR_REQUEST_BODY_FILE=./request-body.json

# Optional headers copied from the browser request.
# Keep this as JSON. Cookies are usually not needed for public short-rent search,
# but if the endpoint rejects requests, paste only the required headers here.
SKR_HEADERS_JSON={"content-type":"application/json","accept":"application/json, text/plain, */*","origin":"https://rent.skdirect.co.kr","referer":"https://rent.skdirect.co.kr/short-rent/car-list"}

# Target vehicle from your sample.
TARGET_SHTP_CRNF_ID=2600000001091
TARGET_BRNH_ID=000012
TARGET_NAME=2027 그랜저(GN7)가솔린 캘리그래피
MIN_AVAILABLE_COUNT=1

# Polling.
POLL_INTERVAL_MS=60000
FETCH_TIMEOUT_MS=20000
STATE_FILE=.skr-bot-state.json
NOTIFY_ON_START_IF_AVAILABLE=true
REFRESH_REQUEST_TIMESTAMPS=true
DEBUG_RESPONSE_FILE=

# Set true to print Discord messages instead of sending them.
DRY_RUN=false
